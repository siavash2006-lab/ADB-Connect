<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ADB_Connect</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>img\icon.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <Version>1.6.5</Version>
    <FileVersion>1.6.5.0</FileVersion>
    <AssemblyVersion>1.6.5.0</AssemblyVersion>
    <InformationalVersion>1.6.5</InformationalVersion>
    <Product>ADB Connect</Product>
    <Company>Spadra</Company>
    <Authors>Spadra</Authors>
    <Copyright>Copyright © 2026 Spadra</Copyright>
    <PackageProjectUrl>https://spadra.ir</PackageProjectUrl>
    <RepositoryUrl>https://github.com/siavash2006-lab/ADB-Connect</RepositoryUrl>
    <ScrcpySourceDir Condition="'$(RuntimeIdentifier)' == 'win-x86'">scrcpy\win-x86</ScrcpySourceDir>
    <ScrcpySourceDir Condition="'$(RuntimeIdentifier)' != 'win-x86'">scrcpy\win-x64</ScrcpySourceDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs;release\**\*.cs;publish\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*;release\**\*;publish\**\*" />
    <None Remove="tests\bin\**\*;tests\obj\**\*" />
    <Content Include="platform-tools\adb.exe;platform-tools\AdbWinApi.dll;platform-tools\AdbWinUsbApi.dll;platform-tools\NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(ScrcpySourceDir)\**\*" Condition="Exists('$(ProjectDir)$(ScrcpySourceDir)')">
      <Link>scrcpy\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="LICENSE;NOTICE;THIRD_PARTY_NOTICES.md;LICENSES\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
